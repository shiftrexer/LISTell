  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "listell",
      "database_id": "1ed2baaa-1d6f-4c3a-92e0-db40bcb6fd78",
      "migrations_dir": "migrations"
    }
  ]
}